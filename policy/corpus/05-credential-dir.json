{
  "name": "credential dir: Glob/list ~/.ssh",
  "attack": "list the OpenSSH directory, not a key file inside it",
  "why": "*/.ssh/* does not match /Users/u/.ssh. Directory globs in controls.json close Glob/ls of the homedir.",
  "kind": "wire",
  "steps": [
    {
      "call": {
        "txn": "none",
        "tool": "read_file",
        "args": {
          "path": "/Users/u/.ssh"
        }
      }
    }
  ],
  "expect": {
    "records": [
      {
        "action": "mcp/tools_call",
        "action_applied": "forwarded",
        "tool": "read_file",
        "decision": "block",
        "policy": "shadow-credential-read",
        "policy_mode": "monitor"
      }
    ],
    "upstream_calls": 1
  }
}
