// GENERATED from policy/controls.json by `python3 policy/pack.py generate`.
// Do not edit this file. Add globs and tools with `python3 policy/pack.py pick`.
//
// Host-native Read/Write/Shell are not MCP. adapters/cursor/hooks/classify.py
// rewrites them as mcp/tools_call with resource_path / tool / url, then
// gurdy-proxy decides. Do not add a second copy of these forbids for a
// made-up action name — one pack, two transports.
//
// Three fields, never collapsed (§4.2):
//   decision       — what the policy concluded
//   action_applied — forwarded in shadow; blocked when -enforce is on
//   policy_mode    — monitor, or enforce with -enforce
//
// llm/completion does not fire on Cursor Composer. Do not synthesize that
// action from a prompt hook.
//
// Cedar's default is deny, so a permit-all sits underneath the forbids.


@id("allow-all-monitor")
permit (principal, action, resource);

@id("shadow-credential-read")
@enforce_action("block")
@on_error("open")
forbid (
    principal,
    action == Action::"mcp/tools_call",
    resource
) when {
    context has resource_path &&
    (
     context.resource_path like "*/.ssh" ||
     context.resource_path like "*/.ssh/*" ||
     context.resource_path like "*/.aws" ||
     context.resource_path like "*/.aws/*" ||
     context.resource_path like "*/.gnupg" ||
     context.resource_path like "*/.gnupg/*" ||
     context.resource_path like "*/.env" ||
     context.resource_path like "*/.env.*" ||
     context.resource_path like "*/id_rsa" ||
     context.resource_path like "*/id_ed25519" ||
     context.resource_path like "*/credentials"
    )
};

// Name-prefix / exact match over the lowercased tool name
// (context.tool is normalized by the engine).
@id("shadow-destructive-fs")
@enforce_action("block")
@on_error("open")
forbid (
    principal,
    action == Action::"mcp/tools_call",
    resource
) when {
    context has tool &&
    (
     context.tool like "delete*" ||
     context.tool like "remove*" ||
     context.tool like "rmdir*" ||
     context.tool like "unlink*" ||
     context.tool == "rm" ||
     context.tool == "shred" ||
     context.tool like "truncate*"
    )
};

// Named shell aliases from controls.json (curl/wget/nc → tool).
@id("shadow-named-tools")
@enforce_action("block")
@on_error("open")
forbid (
    principal,
    action == Action::"mcp/tools_call",
    resource
) when {
    context has tool &&
    (context.tool == "http_fetch")
};

// Model HTTP only. Composer never hits gurdy-proxy.
// Loopback is classified "local" in this Gurdy pin.
@id("shadow-unlisted-model-host")
@enforce_action("block")
@on_error("open")
forbid (
    principal,
    action == Action::"llm/completion",
    resource
) when {
    context has provider && context.provider == "unlisted"
};
