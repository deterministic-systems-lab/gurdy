<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.gurdy.push</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/sh</string>
		<string>__PUSH_SH__</string>
	</array>
	<key>StartInterval</key>
