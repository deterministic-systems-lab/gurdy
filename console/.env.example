# Runtime env. Copy to .env.local for local dev.
# DATABASE_URL comes from the Neon project (not the neon API key in /.keys).
# AUTH_SECRET is generated (openssl rand -base64 32), not from /.keys.
# RESEND_API_KEY is the one /.keys value that is also app config.

DATABASE_URL=
AUTH_SECRET=
AUTH_URL=
RESEND_API_KEY=
EMAIL_FROM=
ADMIN_EMAILS=

# Vercel AI Gateway, for "Explain" on a violation row. Deployments on Vercel
# can use OIDC instead. Without either, the button reports it is not
# configured and nothing else on the page changes.
AI_GATEWAY_API_KEY=
# Optional. Defaults to anthropic/claude-sonnet-4.6.
EXPLAIN_MODEL=
